{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "CareerTracker: India Top MBA & Undergrad Wealth Simulator",
  "short_name": "CareerTracker",
  "description": "Interactive 20-year post-tax compensation, loan EMI, and 9.0% portfolio wealth simulator comparing Top 20 Indian MBAs vs Direct Undergrad routes.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "careertracker-web-app",
  "display": "standalone",
  "background_color": "#0b101b",
  "theme_color": "#0b101b",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/images/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
